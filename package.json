{
  "name": "pescaderia",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm run dev -w server\" \"npm run dev -w client\"",
    "db:local": "npm run db:local -w server",
    "db:migrar": "npm run db:migrar -w server",
    "db:seed": "npm run db:seed -w server",
    "db:demo": "npm run db:demo -w server",
    "build": "npm run build -w client",
    "start": "npm start -w server",
    "test": "npm test -w server"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
  "engines": {
    "node": ">=22.9"
  }
}
