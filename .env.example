# Copiá este archivo como .env y completá los valores.

NODE_ENV=development
PORT=3000
TZ=America/Argentina/Cordoba

# Base de datos.
#  - Desarrollo sin Docker: `npm run db:local` levanta un Postgres embebido en el puerto 54320.
#  - Con Docker: docker compose up -d  (puerto 5432)
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54320/postgres
# Con el Postgres embebido (db:local) dejalo en 1: acepta una sola conexión.
DB_POOL_MAX=1

# Cadena larga y aleatoria. Generala con:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=cambiame-por-una-cadena-larga-y-aleatoria

# Detrás de Nginx en producción: TRUST_PROXY=1 y COOKIE_SECURE=true
TRUST_PROXY=0
COOKIE_SECURE=false
LOG_LEVEL=info

# Usuario dueño que se crea la primera vez (solo si no hay usuarios).
ADMIN_USUARIO=admin
ADMIN_PASSWORD=admin1234
ADMIN_PIN=1234
